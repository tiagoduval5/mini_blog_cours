{% extends 'base.html.twig' %}

{% block title %}Gestion des commentaires - Admin{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Modération des commentaires</h1>
    <hr>

    <div class="mb-4">
        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">Retour au tableau de bord</a>
    </div>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link {% if status == 'pending' %}active{% endif %}" href="{{ path('app_admin_comments', {status: 'pending'}) }}">
                En attente
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if status == 'approved' %}active{% endif %}" href="{{ path('app_admin_comments', {status: 'approved'}) }}">
                Approuvés
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if status == 'rejected' %}active{% endif %}" href="{{ path('app_admin_comments', {status: 'rejected'}) }}">
                Rejetés
            </a>
        </li>
    </ul>

    {% if comments %}
        <div class="comments-list">
            {% for comment in comments %}
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title">{{ comment.author.firstName }} {{ comment.author.lastName }}</h6>
                        <p class="text-muted small">{{ comment.createdAt|date('d/m/Y à H:i') }} | Article: <strong>{{ comment.post.title }}</strong></p>
                        <p class="card-text">{{ comment.content }}</p>
                        
                        {% if status == 'pending' %}
                            <form method="POST" action="{{ path('app_admin_approve_comment', {id: comment.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ comment.id) }}">
                                <button type="submit" class="btn btn-sm btn-primary">✅ Approuver</button>
                            </form>
                            <form method="POST" action="{{ path('app_admin_reject_comment', {id: comment.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ comment.id) }}">
                                <button type="submit" class="btn btn-sm btn-secondary">❌ Rejeter</button>
                            </form>
                        {% endif %}

                        <form method="POST" action="{{ path('app_admin_delete_comment', {id: comment.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                            <button type="submit" class="btn btn-sm btn-dark" onclick="return confirm('Êtes-vous sûr ?')">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">Aucun commentaire dans cette catégorie.</div>
    {% endif %}
</div>
{% endblock %}
