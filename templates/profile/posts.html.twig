{% extends 'base.html.twig' %}

{% block title %}Mes articles - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Mes articles</h1>
    <hr>

    <div class="mb-4">
        <a href="{{ path('app_post_new') }}" class="btn btn-primary">Créer un nouvel article</a>
        <a href="{{ path('app_profile') }}" class="btn btn-secondary">Retour au profil</a>
    </div>

    {% if posts %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Catégorie</th>
                    <th>Date</th>
                    <th>Commentaires</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr>
                        <td><strong>{{ post.title }}</strong></td>
                        <td><span class="badge bg-info">{{ post.category.name }}</span></td>
                        <td>{{ post.publishedAt|date('d/m/Y') }}</td>
                        <td>{{ post.comments|length }}</td>
                        <td>
                            <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                            <a href="{{ path('app_post_edit', {id: post.id}) }}" class="btn btn-sm btn-secondary">✏️ Éditer</a>
                            <form method="POST" action="{{ path('app_post_delete', {id: post.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                    <button type="submit" class="btn btn-sm btn-dark" onclick="return confirm('Êtes-vous sûr ?')">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="alert alert-info">
            Vous n'avez pas encore d'articles. <a href="{{ path('app_post_new') }}" class="alert-link">Créez un!</a>
        </div>
    {% endif %}
</div>
{% endblock %}
