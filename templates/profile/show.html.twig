{% extends 'base.html.twig' %}

{% block title %}Mon profil - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">👤 Mon profil</h4>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5>Prénom: <strong>{{ user.firstName }}</strong></h5>
                        <h5>Nom: <strong>{{ user.lastName }}</strong></h5>
                        <h5>Email: <strong>{{ user.email }}</strong></h5>
                        <h5>Membre depuis: <strong>{{ user.createdAt|date('d/m/Y') }}</strong></h5>
                    </div>

                    <a href="{{ path('app_profile_edit') }}" class="btn btn-secondary">✏️ Éditer mon profil</a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="alert alert-info mt-3">
                            🔐 Vous êtes administrateur
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0">📊 Statistiques</h5>
                </div>
                <div class="card-body">
                    <p><strong>Mes articles:</strong> {{ user.posts|length }}</p>
                    <p><strong>Mes commentaires:</strong> {{ user.comments|length }}</p>
                </div>
            </div>

            <div class="card shadow mt-3">
                <div class="card-body">
                    <a href="{{ path('app_profile_posts') }}" class="btn btn-primary w-100">Voir mes articles</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
