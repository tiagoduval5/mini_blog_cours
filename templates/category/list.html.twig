{% extends 'base.html.twig' %}

{% block title %}Catégories - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="mb-5">
        <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">🏷️ Catégories</h1>
        <p class="text-muted" style="font-size: 1.1rem;">Explorez nos articles par catégorie</p>
        <hr style="border: none; border-top: 3px solid #007bff; width: 100px;">
    </div>

    {% if categories %}
        <div class="row">
            {% for category in categories %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm" style="transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.5rem 1rem rgba(0,0,0,0.15)'">
                        <div class="card-body">
                            <h5 class="card-title" style="font-weight: 600; font-size: 1.3rem; margin-bottom: 1rem;">{{ category.name }}</h5>
                            {% if category.description %}
                                <p class="card-text text-muted" style="margin-bottom: 1rem;">{{ category.description }}</p>
                            {% endif %}
                            <p class="text-muted small">
                                <strong>{{ category.posts|length }}</strong> article{{ category.posts|length > 1 ? 's' : '' }}
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top">
                            <a href="{{ path('app_category_articles', {id: category.id}) }}" class="btn btn-primary btn-sm">Voir les articles →</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            Aucune catégorie pour le moment.
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_category_new') }}" class="alert-link">En créer une!</a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
