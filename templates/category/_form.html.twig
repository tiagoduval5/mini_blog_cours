{{ form_start(form, {attr: {class: 'needs-validation'}}) }}
    <div class="mb-3">
        {{ form_label(form.name, 'Nom', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.name, {attr: {class: 'form-control', placeholder: 'Nom de la catégorie'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.description, 'Description', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.description, {attr: {class: 'form-control', rows: 4, placeholder: 'Description de la catégorie'}}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <button type="submit" class="btn btn-primary btn-lg">{{ button_label|default('Créer') }}</button>
        <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary btn-lg">Annuler</a>
    </div>
{{ form_end(form) }}
