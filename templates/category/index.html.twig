{% extends 'base.html.twig' %}

{% block title %}Gestion des catégories - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🏷️ Catégories</h1>
        <a href="{{ path('app_category_new') }}" class="btn btn-primary">➕ Nouvelle catégorie</a>
    </div>

    {% if categories %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th style="width: 200px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td><strong>{{ category.name }}</strong></td>
                            <td>{{ category.description|slice(0, 50) }}{% if category.description|length > 50 %}...{% endif %}</td>
                            <td style="text-align: center;">
                                <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-sm btn-info">👁️ Voir</a>
                                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-warning">✏️ Éditer</a>
                                <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                    <button class="btn btn-sm btn-danger">🗑️ Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            Aucune catégorie pour le moment. <a href="{{ path('app_category_new') }}" class="alert-link">En créer une!</a>
        </div>
    {% endif %}
</div>
{% endblock %}
