{% extends 'base.html.twig' %}

{% block title %}Tous les articles - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="mb-5">
        <h1 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">📚 Tous les Articles</h1>
        <p class="text-muted" style="font-size: 1.1rem;">Découvrez nos derniers articles et publications</p>
        <hr style="border: none; border-top: 3px solid #007bff; width: 100px;">
    </div>

    {% if posts %}
        <div class="row">
            {% for post in posts %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm" style="transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 25px rgba(0,0,0,0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.5rem 1rem rgba(0,0,0,0.15)'">
                        {% if post.picture %}
                            <div style="height: 250px; overflow: hidden;">
                                <img src="{{ post.picture }}" class="card-img-top" alt="{{ post.title }}" style="height: 100%; width: 100%; object-fit: cover;">
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-primary mb-2" style="width: fit-content;">{{ post.category.name }}</span>
                            <h5 class="card-title" style="font-weight: 600; font-size: 1.3rem; margin-bottom: 1rem;">{{ post.title }}</h5>
                            <div class="text-muted small mb-3" style="border-bottom: 1px solid #e9ecef; padding-bottom: 0.75rem;">
                                {{ post.author.firstName }} {{ post.author.lastName }}
                                <span class="mx-2">•</span>
                                {{ post.publishedAt|date('d/m/Y') }}
                            </div>
                            <p class="card-text flex-grow-1" style="font-size: 0.95rem; color: #555; line-height: 1.6;">{{ post.content[:120] }}...</p>
                        </div>
                        <div class="card-footer bg-white border-top">
                            <a href="{{ path('app_post_show', { id: post.id }) }}" class="btn btn-primary btn-sm">Lire la suite →</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Pagination -->
        {% if pages > 1 %}
            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    {% if page > 1 %}
                        <li class="page-item"><a class="page-link" href="{{ path('app_posts_list', {page: page - 1}) }}">Précédent</a></li>
                    {% endif %}
                    
                    {% for p in 1..pages %}
                        <li class="page-item {% if p == page %}active{% endif %}"><a class="page-link" href="{{ path('app_posts_list', {page: p}) }}">{{ p }}</a></li>
                    {% endfor %}

                    {% if page < pages %}
                        <li class="page-item"><a class="page-link" href="{{ path('app_posts_list', {page: page + 1}) }}">Suivant</a></li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info" role="alert">
            Aucun article pour le moment. 
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_post_new') }}" class="alert-link">Créez un!</a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
