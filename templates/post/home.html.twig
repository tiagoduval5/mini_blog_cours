{% extends 'base.html.twig' %}

{% block title %}Accueil - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <h1 style="font-size: 3rem; font-weight: 800; margin-bottom: 1rem;">Bienvenue sur notre Blog 📝</h1>
            <p class="lead" style="font-size: 1.2rem; color: #555; margin-bottom: 2rem;">Explorez une collection d'articles passionnants et découvrez de nouvelles perspectives sur divers sujets intéressants.</p>
            <div>
                <a href="{{ path('app_posts_list') }}" class="btn btn-primary btn-lg me-3" style="padding: 0.75rem 2rem; font-weight: 600;">
                    📖 Voir tous les articles
                </a>
                {% if app.user %}
                    <a href="{{ path('app_post_new') }}" class="btn btn-primary btn-lg" style="padding: 0.75rem 2rem; font-weight: 600;">
                        ✍️ Écrire un article
                    </a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-info btn-lg" style="padding: 0.75rem 2rem; font-weight: 600;">
                         S'inscrire maintenant
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {% if latestPosts %}
        <section class="mb-5">
            <h2 class="mb-4" style="font-size: 2rem; font-weight: 700;">🔥 Articles Récents</h2>
            <div class="row">
                {% for post in latestPosts %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm" style="transition: transform 0.3s ease, box-shadow 0.3s ease; border: none; border-radius: 10px;" onmouseover="this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 30px rgba(0,0,0,0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 0.5rem 1rem rgba(0,0,0,0.15)'">
                            {% if post.picture %}
                                <div style="height: 200px; overflow: hidden; border-radius: 10px 10px 0 0;">
                                    <img src="{{ post.picture }}" class="card-img-top" alt="{{ post.title }}" style="height: 100%; width: 100%; object-fit: cover;">
                                </div>
                            {% endif %}
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-primary mb-2" style="width: fit-content;">{{ post.category.name }}</span>
                                <h5 class="card-title" style="font-weight: 600; font-size: 1.2rem; margin-bottom: 1rem;">{{ post.title }}</h5>
                                <div class="text-muted small mb-3" style="border-bottom: 1px solid #e9ecef; padding-bottom: 0.75rem;">
                                    <span>{{ post.author.firstName }} {{ post.author.lastName }}</span><span class="mx-2">•</span><span>{{ post.publishedAt|date('d/m/Y') }}</span>
                                </div>
                                <p class="card-text flex-grow-1" style="font-size: 0.95rem; color: #555; line-height: 1.6;">{{ post.content[:85] }}...</p>
                            </div>
                            <div class="card-footer bg-white border-top" style="border-radius: 0 0 10px 10px;">
                                <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-sm btn-primary">Lire la suite →</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="text-center mt-4">
                <a href="{{ path('app_posts_list') }}" class="btn btn-outline-primary btn-lg" style="padding: 0.6rem 2rem; font-weight: 600;">
                    Voir tous les articles
                </a>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
