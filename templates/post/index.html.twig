{% extends 'base.html.twig' %}

{% block title %}Gestion des articles - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📋 Mes articles</h1>
        <a href="{{ path('app_post_new') }}" class="btn btn-primary">➕ Nouvel article</a>
    </div>

    {% if posts %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Titre</th>
                        <th>Catégorie</th>
                        <th>Date de publication</th>
                        <th style="width: 200px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in posts %}
                        <tr>
                            <td><strong>{{ post.title }}</strong></td>
                            <td><span class="badge bg-primary">{{ post.category.name }}</span></td>
                            <td>{{ post.publishedAt ? post.publishedAt|date('d M Y') : 'Non publié' }}</td>
                            <td style="text-align: center;">
                                <a href="{{ path('app_post_show', {'id': post.id}) }}" class="btn btn-sm btn-info">👁️ Voir</a>
                                <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-warning">✏️ Éditer</a>
                                <form method="post" action="{{ path('app_post_delete', {'id': post.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                    <button class="btn btn-sm btn-danger">🗑️ Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            Vous n'avez pas encore d'articles. <a href="{{ path('app_post_new') }}" class="alert-link">Créez votre premier article!</a>
        </div>
    {% endif %}
</div>
{% endblock %}
