{% extends 'base.html.twig' %}

{% block title %}Modifier l'article - Mon Blog{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h4 class="mb-0">✏️ Modifier l'article</h4>
                </div>
                <div class="card-body">
                    {{ include('post/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
                </div>
            </div>

            <div class="mt-4">
                <a href="{{ path('app_post_show', {id: post.id}) }}" class="btn btn-outline-secondary">← Retour à l'article</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
